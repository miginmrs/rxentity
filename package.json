{
  "name": "rxentity",
  "version": "0.1.0",
  "description": "RxJS stores of observable records, with inherited layers and weakly cached lists.",
  "keywords": [
    "rxjs",
    "entity",
    "store",
    "observable",
    "reactive",
    "cache",
    "pagination"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "author": "miginmrs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miginmrs/rxentity.git"
  },
  "bugs": {
    "url": "https://github.com/miginmrs/rxentity/issues"
  },
  "homepage": "https://github.com/miginmrs/rxentity#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE.txt",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.examples.json && tsc -p tsconfig.test.json",
    "test": "npm run build && npm run typecheck && node --test \"examples/*.test.ts\" \"test/*.test.ts\"",
    "prepublishOnly": "npm test",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "rxjs": ">=7.0.0 <8"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^24.5.2",
    "publint": "^0.3.24",
    "rxjs": "^7.8.2",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.2"
  }
}
